{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EDY075/EDY-SOC-Analytics/contracts/edy-siem-export.schema.json",
  "title": "EDY SIEM Analytics Export",
  "description": "Contrato seguro e demonstrativo para exportação futura. Não transporta evidências, payloads nem credenciais.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exportId", "generatedAt", "sourceProduct", "records"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "exportId": {"type": "string", "pattern": "^EXP-[0-9]{8}-[A-Z0-9]{6}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "sourceProduct": {"enum": ["EDY SIEM"]},
    "dataClassification": {"const": "SYNTHETIC_DEMO_DATA"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/securityRecord"}
    }
  },
  "$defs": {
    "securityRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "recordType", "occurredAt", "severity", "status", "sourceProduct", "sourceSystem", "assetId", "ruleId"],
      "properties": {
        "recordId": {"type": "string", "pattern": "^(EVT|ALT|INC)-[0-9]{8}$"},
        "recordType": {"enum": ["Event", "Alert", "Incident"]},
        "occurredAt": {"type": "string", "format": "date-time"},
        "severity": {"enum": ["Informational", "Low", "Medium", "High", "Critical"]},
        "status": {"enum": ["New", "Active", "Contained", "Resolved", "Closed"]},
        "sourceProduct": {"enum": ["EDY Shield", "EDY Sentinel", "EDY SIEM", "EDY RECON", "External Synthetic"]},
        "sourceSystem": {"type": "string", "minLength": 2, "maxLength": 80},
        "assetId": {"type": "string", "pattern": "^AST-[0-9]{4}$"},
        "ruleId": {"type": "string", "pattern": "^RUL-[0-9]{3}$"},
        "mitreTechniqueIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}},
        "isFalsePositive": {"type": "boolean"},
        "safeSummary": {"type": "string", "maxLength": 240, "pattern": "^[^<>]*$"}
      }
    }
  }
}

